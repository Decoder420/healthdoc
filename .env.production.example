# Copy outside the repository as .env.production, replace every placeholder,
# chmod 600, and back it up separately from application data.
# Keep credentials embedded in connection URLs URL-safe (letters, digits, _ and -).
PUBLIC_HOST=healthdoc.example.org
TLS_CERT_PATH=/etc/healthdoc/tls/fullchain.pem
TLS_KEY_PATH=/etc/healthdoc/tls/privkey.pem
POSTGRES_USER=healthdoc
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_DB=healthdoc
MONGO_ROOT_USER=healthdoc
MONGO_ROOT_PASSWORD=replace-with-random-password
REDIS_PASSWORD=replace-with-random-password
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-random-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-random-password
MINIO_ROOT_USER=healthdoc
MINIO_ROOT_PASSWORD=replace-with-random-password
PII_ENCRYPTION_KEY=replace-with-base64-32-byte-key
AADHAAR_HMAC_KEY=replace-with-base64-32-byte-key
ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=replace-for-environment
ABDM_CLIENT_SECRET=replace-for-environment
ABDM_HFR_FACILITY_ID=replace-for-environment
ABDM_X_CM_ID=sbx
HEALTHDOC_BACKEND_IMAGE=healthdoc-backend:release
HEALTHDOC_FRONTEND_IMAGE=healthdoc-frontend:release
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-password
GRAFANA_PORT=3001
