{
  "_comment": "Five read-only clinical journeys using short-lived bearer tokens captured by capture_load_tokens.sh. Ten users per journey gives 50 concurrent authenticated users. The default two-second average think time keeps the workload below the intentional 30 request/second per-source-IP Nginx safety limit.",
  "base_url": "https://localhost",
  "verify_tls": false,
  "token_path": "/keycloak/realms/healthdoc/protocol/openid-connect/token",
  "client_id": "healthdoc-frontend",
  "actors": [
    {
      "name": "opd-doctor",
      "users": 10,
      "token_file": "doctor.json",
      "scenarios": [
        { "name": "worklist", "method": "GET", "path": "/api/v1/queue/worklist" }
      ]
    },
    {
      "name": "ipd-nurse",
      "users": 10,
      "token_file": "nurse.json",
      "scenarios": [
        { "name": "tasks", "method": "GET", "path": "/api/v1/nursing/tasks" }
      ]
    },
    {
      "name": "lab",
      "users": 10,
      "token_file": "lab-technician.json",
      "scenarios": [
        { "name": "order-items", "method": "GET", "path": "/api/v1/pathology/order-items" }
      ]
    },
    {
      "name": "pharmacy",
      "users": 10,
      "token_file": "pharmacist.json",
      "scenarios": [
        { "name": "queue", "method": "GET", "path": "/api/v1/pharmacy/queue" }
      ]
    },
    {
      "name": "billing",
      "users": 10,
      "token_file": "billing-receptionist.json",
      "scenarios": [
        { "name": "invoices", "method": "GET", "path": "/api/v1/billing/invoices" }
      ]
    }
  ]
}
