{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "healthdoc-prometheus"},
      "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "up{job=\"healthdoc-backend\"}", "refId": "A"}],
      "title": "Backend scrape health",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "healthdoc-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 18, "x": 6, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum by (method) (rate(healthdoc_http_requests_total[5m]))", "legendFormat": "{{method}}", "refId": "A"}],
      "title": "Request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "healthdoc-prometheus"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "100 * sum(rate(healthdoc_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(healthdoc_http_requests_total[5m])), 0.001)", "refId": "A"}],
      "title": "5xx response rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "healthdoc-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(healthdoc_http_request_duration_seconds_bucket[5m])))", "refId": "A"}],
      "title": "API p95 latency",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["healthdoc", "production"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "HealthDoc API",
  "uid": "healthdoc-api",
  "version": 1
}
